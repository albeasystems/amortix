// MARK: - KPI info
"kpi_monthly_payment_title" = "मासिक EMI";
"kpi_monthly_payment_explanation" = "लोन की पूरी अवधि में हर महीने भुगतान की जाने वाली निश्चित राशि। इसमें मूलधन का हिस्सा (लोन की वापसी) और ब्याज का हिस्सा (उधार लिए पैसे की लागत) शामिल होता है।";
"kpi_monthly_payment_formula" = "P × [r(1+r)^n] / [(1+r)^n - 1]\nP=मूलधन  r=मासिक दर  n=महीने";
"kpi_monthly_payment_example" = "₹20 लाख लोन, 30 वर्ष, 3.5% दर → मासिक EMI ₹898।";

"kpi_total_interest_title" = "कुल ब्याज";
"kpi_total_interest_explanation" = "लोन की पूरी अवधि में भुगतान किए जाने वाले सभी ब्याज का योग। दर या अवधि जितनी अधिक, ब्याज उतना ज़्यादा।";
"kpi_total_interest_formula" = "";
"kpi_total_interest_example" = "₹20 लाख लोन, 30 वर्ष, 3.5% दर पर केवल ब्याज में लगभग ₹12.3 लाख चुकाने होंगे।";

"kpi_total_cost_title" = "कुल लागत";
"kpi_total_cost_explanation" = "बैंक को वापस करने वाला कुल पैसा: उधार ली गई मूल राशि + सभी ब्याज। दो लोन की तुलना करने का यह सबसे अच्छा पैमाना है।";
"kpi_total_cost_formula" = "";
"kpi_total_cost_example" = "मूलधन ₹20 लाख + ब्याज ₹12.3 लाख = कुल लागत ₹32.3 लाख।";

"kpi_months_saved_title" = "बचाए गए महीने";
"kpi_months_saved_explanation" = "आंशिक प्री-पेमेंट से अवधि कम करना चुनने पर ये वे महीने हैं जो आपको चुकाने नहीं होंगे। लोन की शुरुआत में प्री-पेमेंट करने पर बचत ज़्यादा होती है।";
"kpi_months_saved_formula" = "n_नई = -ln(1 - P_नई × r / EMI) / ln(1 + r)";
"kpi_months_saved_example" = "30 वर्षीय लोन के 5वें वर्ष में ₹2 लाख का प्री-पेमेंट 4-6 साल बचा सकता है।";

"kpi_interest_saved_title" = "बचाया गया ब्याज";
"kpi_interest_saved_explanation" = "प्री-पेमेंट के बिना और उसके बाद चुकाए जाने वाले ब्याज का अंतर। यह शुल्क काटने से पहले की सकल बचत है।";
"kpi_interest_saved_formula" = "";
"kpi_interest_saved_example" = "₹2 लाख का प्री-पेमेंट, समय के अनुसार ₹8,000 से ₹18,000 तक ब्याज बचा सकता है।";

"kpi_net_saving_title" = "शुद्ध बचत";
"kpi_net_saving_explanation" = "वास्तविक बचत: बचाया गया ब्याज घटाकर बैंक द्वारा लिया गया प्री-पेमेंट शुल्क। यदि ऋणात्मक हो तो प्री-पेमेंट फ़ायदेमंद नहीं है।";
"kpi_net_saving_formula" = "शुद्ध बचत = बचाया गया ब्याज − शुल्क";
"kpi_net_saving_example" = "बचाया गया ब्याज ₹15,000 − शुल्क ₹500 = शुद्ध बचत ₹14,500।";

"kpi_commission_title" = "प्री-पेमेंट शुल्क";
"kpi_commission_explanation" = "बैंक समयपूर्व भुगतान पर शुल्क ले सकता है। नियम देश के अनुसार अलग-अलग होते हैं और उपभोक्ता की रक्षा करते हैं।";
