"kpi_commission_example" = "फ्लोटिंग लोन के दूसरे वर्ष में ₹2 लाख का प्री-पेमेंट → शुल्क = 2,00,000 × 0.25% = ₹500।";

"kpi_new_payment_title" = "नई EMI";
