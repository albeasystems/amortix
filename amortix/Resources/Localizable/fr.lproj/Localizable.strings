// MARK: - KPI info
"kpi_monthly_payment_title" = "Mensualité";
"kpi_monthly_payment_explanation" = "Le montant fixe que vous payez chaque mois pendant toute la durée du prêt. Il comprend une part de capital (ce que vous remboursez du prêt) et une part d'intérêts (le coût de l'argent emprunté).";
"kpi_monthly_payment_formula" = "C × [r(1+r)^n] / [(1+r)^n - 1]\nC=capital  r=taux mensuel  n=mois";
"kpi_monthly_payment_example" = "Prêt de 200 000 € sur 30 ans à 3,5 % → mensualité de 898 €.";

"kpi_total_interest_title" = "Total des intérêts";
"kpi_total_interest_explanation" = "La somme de tous les intérêts que vous paierez sur la durée du prêt. Plus le taux ou la durée est élevé, plus vous paierez d'intérêts.";
"kpi_total_interest_formula" = "";
"kpi_total_interest_example" = "Pour un prêt de 200 000 € sur 30 ans à 3,5 %, vous paierez environ 123 000 € rien qu'en intérêts.";

"kpi_total_cost_title" = "Coût total";
"kpi_total_cost_explanation" = "L'argent total que vous rembourserez à la banque : capital emprunté + tous les intérêts. C'est la meilleure mesure pour comparer deux prêts.";
"kpi_total_cost_formula" = "";
"kpi_total_cost_example" = "Capital 200 000 € + 123 000 € d'intérêts = 323 000 € de coût total.";

"kpi_months_saved_title" = "Mois économisés";
"kpi_months_saved_explanation" = "Si vous choisissez de réduire la durée avec un remboursement partiel, voici les mois que vous ne paierez plus. Plus c'est tôt dans le prêt, plus l'économie est grande.";
"kpi_months_saved_formula" = "n_nouveau = -ln(1 - C_nouveau × r / mensualité) / ln(1 + r)";
"kpi_months_saved_example" = "Rembourser 20 000 € en année 5 d'un prêt sur 30 ans pourrait éliminer 4 à 6 ans de paiements.";

"kpi_interest_saved_title" = "Intérêts économisés";
"kpi_interest_saved_explanation" = "La différence entre les intérêts que vous paieriez sans remboursement anticipé et ceux que vous paierez après. C'est l'économie brute avant déduction de l'indemnité.";
"kpi_interest_saved_formula" = "";
"kpi_interest_saved_example" = "Rembourser 20 000 € peut économiser entre 8 000 € et 18 000 € d'intérêts selon le moment.";

"kpi_net_saving_title" = "Économie nette";
"kpi_net_saving_explanation" = "L'économie réelle : intérêts économisés moins l'indemnité de remboursement anticipé facturée par la banque. Si elle est négative, le remboursement anticipé n'est pas rentable.";
"kpi_net_saving_formula" = "Économie nette = Intérêts économisés − Indemnité";
"kpi_net_saving_example" = "Intérêts économisés 15 000 € − Indemnité 500 € = Économie nette 14 500 €.";

"kpi_commission_title" = "Indemnité de remboursement";
"kpi_commission_explanation" = "La banque peut facturer une indemnité pour un remboursement anticipé. La réglementation varie selon les pays et protège le consommateur.";
"kpi_commission_formula" = "Variable : 0,25 % × montant (ans 1-3)\nFixe : 2 % × montant (ans 1-10)";
"kpi_commission_example" = "Rembourser 20 000 € en an 2 d'un prêt variable → indemnité = 20 000 × 0,25 % = 50 €.";

"kpi_new_payment_title" = "Nouvelle mensualité";
"kpi_new_payment_explanation" = "Si vous choisissez de réduire la mensualité avec un remboursement partiel, ce sera votre nouvelle mensualité pour le reste du prêt, en conservant la durée initiale.";
"kpi_new_payment_formula" = "";
"kpi_new_payment_example" = "Mensualité actuelle 898 €/mois → après remboursement de 20 000 € → nouvelle mensualité 798 €/mois.";

"kpi_euribor_diff_monthly_title" = "Différence mensuelle";
"kpi_euribor_diff_monthly_explanation" = "De combien varie votre mensualité si les taux montent ou baissent selon le scénario simulé. Une valeur positive signifie que vous paierez plus.";
"kpi_euribor_diff_monthly_formula" = "";
"kpi_euribor_diff_monthly_example" = "Si les taux augmentent de 1 point, un prêt de 150 000 € sur 20 ans peut augmenter d'environ 60 €/mois.";

"kpi_amortize_saving_title" = "Économie en remboursant";
"kpi_amortize_saving_explanation" = "Le bénéfice garanti d'utiliser cet argent pour rembourser votre prêt. C'est équivalent à obtenir un rendement égal au taux de votre prêt, sans risque.";
"kpi_amortize_saving_formula" = "Capital × ((1 + taux)^années − 1)";
"kpi_amortize_saving_example" = "20 000 € sur un prêt à 3,5 % pendant 10 ans → économie garantie de 9 773 €.";

"kpi_invest_gain_title" = "Gain en investissant";
"kpi_invest_gain_explanation" = "Le bénéfice attendu d'investir cet argent plutôt que de rembourser le prêt, en appliquant le rendement annuel que vous saisissez. N'oubliez pas que l'investissement comporte des risques et que les rendements ne sont pas garantis.";
"kpi_invest_gain_formula" = "Capital × ((1 + rendement)^années − 1)";
"kpi_invest_gain_example" = "20 000 € à 7 % annuel pendant 10 ans → gain attendu de 19 343 €.";

