// MARK: - KPI info
"kpi_monthly_payment_title" = "Monatliche Rate";
"kpi_monthly_payment_explanation" = "Der feste Betrag, den du jeden Monat während der gesamten Darlehenslaufzeit zahlst. Er enthält einen Tilgungsanteil (was du vom Darlehen zurückzahlst) und einen Zinsanteil (die Kosten des geliehenen Geldes).";
"kpi_monthly_payment_formula" = "K × [r(1+r)^n] / [(1+r)^n - 1]\nK=Kapital  r=Monatszins  n=Monate";
"kpi_monthly_payment_example" = "Darlehen 200.000€ auf 30 Jahre zu 3,5% → monatliche Rate von 898€.";

"kpi_total_interest_title" = "Gesamtzinsen";
"kpi_total_interest_explanation" = "Die Summe aller Zinsen, die du über die Laufzeit des Darlehens zahlen wirst. Je höher der Zinssatz oder die Laufzeit, desto mehr Zinsen zahlst du.";
"kpi_total_interest_formula" = "";
"kpi_total_interest_example" = "Bei einem Darlehen von 200.000€ über 30 Jahre zu 3,5% zahlst du rund 123.000€ allein an Zinsen.";

"kpi_total_cost_title" = "Gesamtkosten";
"kpi_total_cost_explanation" = "Das gesamte Geld, das du an die Bank zurückzahlst: geliehenes Kapital + alle Zinsen. Dies ist der beste Vergleichsmaßstab für zwei Darlehen.";
"kpi_total_cost_formula" = "";
"kpi_total_cost_example" = "Kapital 200.000€ + 123.000€ Zinsen = 323.000€ Gesamtkosten.";

"kpi_months_saved_title" = "Gesparte Monate";
"kpi_months_saved_explanation" = "Wenn du dich für eine Laufzeitverkürzung durch Sondertilgung entscheidest, sind das die Monate, die du nicht mehr zahlen musst. Je früher im Darlehen, desto größer die Ersparnis.";
"kpi_months_saved_formula" = "n_neu = -ln(1 - K_neu × r / Rate) / ln(1 + r)";
"kpi_months_saved_example" = "Eine Sondertilgung von 20.000€ im Jahr 5 eines 30-Jahre-Darlehens könnte 4-6 Jahre einsparen.";

"kpi_interest_saved_title" = "Gesparte Zinsen";
"kpi_interest_saved_explanation" = "Die Differenz zwischen den Zinsen, die du ohne Sondertilgung zahlen würdest, und denen nach der Tilgung. Dies ist die Bruttoersparnis vor Abzug der Vorfälligkeitsentschädigung.";
"kpi_interest_saved_formula" = "";
"kpi_interest_saved_example" = "Eine Sondertilgung von 20.000€ kann je nach Zeitpunkt zwischen 8.000€ und 18.000€ an Zinsen einsparen.";

"kpi_net_saving_title" = "Nettoeinsparung";
"kpi_net_saving_explanation" = "Die tatsächliche Ersparnis: gesparte Zinsen abzüglich der vom Kreditinstitut erhobenen Vorfälligkeitsentschädigung. Ist sie negativ, lohnt sich die Sondertilgung nicht.";
"kpi_net_saving_formula" = "Nettoeinsparung = Gesparte Zinsen − Vorfälligkeitsentschädigung";
"kpi_net_saving_example" = "Gesparte Zinsen 15.000€ − Entschädigung 500€ = Nettoeinsparung 14.500€.";

"kpi_commission_title" = "Vorfälligkeitsentschädigung";
"kpi_commission_explanation" = "Das Kreditinstitut kann für eine vorzeitige Tilgung eine Entschädigung erheben. Die Vorschriften variieren je nach Land und schützen den Verbraucher.";
"kpi_commission_formula" = "Variabel: 0,25% × Betrag (Jahre 1-3)\nFest: 2% × Betrag (Jahre 1-10)";
"kpi_commission_example" = "Sondertilgung 20.000€ im Jahr 2 eines variablen Darlehens → Entschädigung = 20.000 × 0,25% = 50€.";

"kpi_new_payment_title" = "Neue Rate";
"kpi_new_payment_explanation" = "Wenn du dich für eine Ratensenkung durch Sondertilgung entscheidest, ist dies deine neue monatliche Rate für den Rest des Darlehens bei unveränderter Laufzeit.";
"kpi_new_payment_formula" = "";
"kpi_new_payment_example" = "Aktuelle Rate 898€/Monat → nach Sondertilgung von 20.000€ → neue Rate 798€/Monat.";

"kpi_euribor_diff_monthly_title" = "Monatliche Differenz";
"kpi_euribor_diff_monthly_explanation" = "Wie stark sich deine Monatsrate verändert, wenn die Zinsen gemäß dem simulierten Szenario steigen oder fallen. Ein positiver Wert bedeutet, dass du mehr zahlst.";
"kpi_euribor_diff_monthly_formula" = "";
"kpi_euribor_diff_monthly_example" = "Wenn die Zinsen um 1 Punkt steigen, kann ein Darlehen von 150.000€ über 20 Jahre um ~60€/Monat steigen.";

"kpi_amortize_saving_title" = "Ersparnis durch Tilgung";
"kpi_amortize_saving_explanation" = "Der garantierte Vorteil, dieses Geld zur Tilgung einzusetzen. Es entspricht einer risikofreien Rendite in Höhe deines Darlehenszinssatzes.";
"kpi_amortize_saving_formula" = "Kapital × ((1 + Zins)^Jahre − 1)";
"kpi_amortize_saving_example" = "20.000€ bei einem Darlehenszins von 3,5% über 10 Jahre → garantierte Ersparnis von 9.773€.";

"kpi_invest_gain_title" = "Gewinn durch Anlage";
"kpi_invest_gain_explanation" = "Der erwartete Vorteil, dieses Geld anzulegen statt zu tilgen, unter Anwendung der von dir eingegebenen Jahresrendite. Denk daran, dass Geldanlagen Risiken bergen und Erträge nicht garantiert sind.";
"kpi_invest_gain_formula" = "Kapital × ((1 + Rendite)^Jahre − 1)";
"kpi_invest_gain_example" = "20.000€ bei 7% Jahresrendite über 10 Jahre → erwarteter Gewinn von 19.343€.";

