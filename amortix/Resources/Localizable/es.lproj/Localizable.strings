// MARK: - Input field KPIs
"kpi_input_capital_title" = "Capital del préstamo";
"kpi_input_capital_explanation" = "El importe total que solicitas al banco. Es la base sobre la que se calculan los intereses. Cuanto menor sea el capital, menos intereses pagarás en total.";
"kpi_input_capital_example" = "Para comprar una vivienda de 250.000€ con un 20% de entrada, el capital sería 200.000€.";

"kpi_input_years_title" = "Plazo del préstamo";
"kpi_input_years_explanation" = "El número de años durante los que pagarás la hipoteca. Más plazo = cuota más baja, pero muchos más intereses en total. Menos plazo = cuota más alta, pero ahorras en intereses.";
"kpi_input_years_example" = "Una hipoteca a 25 años tiene cuotas más bajas que a 15, pero puede pagar el doble en intereses totales.";

"kpi_input_rate_title" = "Tipo de interés (TIN)";
"kpi_input_rate_explanation" = "El porcentaje anual que el banco cobra por prestarte el dinero. Es el factor más importante que determina el coste de tu hipoteca. Pequeñas diferencias de décimas tienen gran impacto a largo plazo.";
"kpi_input_rate_example" = "En 200.000€ a 25 años, pasar del 3% al 4% supone pagar ~28.000€ más en intereses totales.";

"kpi_input_euribor_title" = "Euribor";
"kpi_input_euribor_explanation" = "El índice de referencia interbancario europeo. Las hipotecas variables se calculan como Euribor + diferencial. Se revisa anualmente y puede subir o bajar.";
"kpi_input_euribor_example" = "Si el Euribor está al 3,75% y tu diferencial es +0,75%, tu TIN efectivo será 4,50%.";

"kpi_input_spread_title" = "Diferencial";
"kpi_input_spread_explanation" = "El margen que suma el banco al Euribor para calcular tu tipo de interés variable. Es fijo durante toda la vida del préstamo y varía según la entidad y tu perfil.";
"kpi_input_spread_example" = "Un diferencial de 0,75% sobre Euribor 3,75% = tipo efectivo 4,50%.";

"kpi_input_remaining_capital_title" = "Capital pendiente";
"kpi_input_remaining_capital_explanation" = "La deuda que todavía tienes con el banco. Es el capital sobre el que se calculan los intereses de las cuotas futuras. Puedes consultarlo en tu último recibo bancario.";
"kpi_input_remaining_capital_example" = "Si compraste por 200.000€ hace 5 años a 25 años, tu capital pendiente será aproximadamente 175.000€.";

"kpi_input_months_title" = "Meses restantes";
"kpi_input_months_explanation" = "El número de cuotas mensuales que quedan por pagar. Equivale al plazo restante de tu hipoteca. 300 meses = 25 años, 240 meses = 20 años.";
"kpi_input_months_example" = "Si firmaste una hipoteca a 30 años hace 5 años, te quedan 300 meses (25 años).";

"kpi_input_amortize_amount_title" = "Importe a amortizar";
"kpi_input_amortize_amount_explanation" = "La cantidad extra que quieres pagar al banco para reducir tu deuda antes de tiempo. Puede ser un ahorro puntual, una herencia, una paga extra, etc.";
"kpi_input_amortize_amount_example" = "Con 20.000€ extra puedes eliminar varios años de hipoteca o reducir significativamente tu cuota mensual.";

"kpi_input_extra_monthly_title" = "Pago extra mensual";
"kpi_input_extra_monthly_explanation" = "Una cantidad adicional que pagarás cada mes por encima de tu cuota normal. Todo este extra va directo a reducir capital, lo que acorta el plazo y ahorra muchos intereses.";
"kpi_input_extra_monthly_example" = "Pagando 200€ extra al mes en una hipoteca de 150.000€ a 25 años al 3,5%, podrías terminar 5-7 años antes.";

"kpi_input_stress_rate_title" = "Tipo base del test";
"kpi_input_stress_rate_explanation" = "El tipo de interés de partida para el test de estrés. La herramienta calculará qué pasaría con tu cuota si el tipo sube o baja varios puntos porcentuales desde esta base.";
"kpi_input_stress_rate_example" = "Con un tipo base del 3,5%, el test calcula tu cuota para escenarios desde 1,5% hasta 8,5%.";

