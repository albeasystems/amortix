// MARK: - KPI info
"kpi_monthly_payment_title" = "Cuota mensual";
"kpi_monthly_payment_explanation" = "Es el importe fijo que pagas cada mes durante toda la vida del préstamo. Incluye una parte de capital (lo que devuelves del préstamo) y una parte de intereses (el coste del dinero prestado).";
"kpi_monthly_payment_formula" = "C × [r(1+r)^n] / [(1+r)^n - 1]\nC=capital  r=tipo mensual  n=meses";
"kpi_monthly_payment_example" = "Préstamo 200.000€ a 30 años al 3,5% → cuota mensual de 898€.";

"kpi_total_interest_title" = "Total intereses";
"kpi_total_interest_explanation" = "La suma de todos los intereses que pagarás a lo largo de la vida del préstamo. Cuanto mayor sea el tipo o el plazo, más intereses pagarás.";
"kpi_total_interest_formula" = "";
"kpi_total_interest_example" = "En un préstamo de 200.000€ a 30 años al 3,5%, pagarás unos 123.000€ solo en intereses.";

"kpi_total_cost_title" = "Coste total";
"kpi_total_cost_explanation" = "El dinero total que devolverás al banco: capital prestado + todos los intereses. Es la mejor métrica para comparar dos hipotecas.";
"kpi_total_cost_formula" = "";
"kpi_total_cost_example" = "Capital 200.000€ + 123.000€ intereses = 323.000€ coste total.";

"kpi_months_saved_title" = "Meses ahorrados";
"kpi_months_saved_explanation" = "Si eliges reducir plazo con una amortización parcial, estos son los meses que dejarás de pagar. Cuanto más al principio del préstamo, mayor será el ahorro.";
"kpi_months_saved_formula" = "n_nuevo = -ln(1 - C_nuevo × r / cuota) / ln(1 + r)";
"kpi_months_saved_example" = "Amortizando 20.000€ en año 5 de una hipoteca a 30 años podrías eliminar 4-6 años de pagos.";

"kpi_interest_saved_title" = "Intereses ahorrados";
"kpi_interest_saved_explanation" = "La diferencia entre los intereses que pagarías sin amortizar y los que pagarás después de amortizar. Es el ahorro bruto antes de descontar la comisión.";
"kpi_interest_saved_formula" = "";
"kpi_interest_saved_example" = "Amortizando 20.000€ puedes ahorrar entre 8.000€ y 18.000€ en intereses según el momento.";

"kpi_net_saving_title" = "Ahorro neto";
"kpi_net_saving_explanation" = "Es el ahorro real: intereses ahorrados menos la comisión por amortización anticipada que cobra el banco. Si es negativo, no compensa amortizar.";
"kpi_net_saving_formula" = "Ahorro neto = Intereses ahorrados − Comisión";
"kpi_net_saving_example" = "Intereses ahorrados 15.000€ − Comisión 500€ = Ahorro neto 14.500€.";

"kpi_commission_title" = "Comisión";
"kpi_commission_explanation" = "El banco puede cobrar una comisión por amortizar anticipadamente. En España está regulada por la Ley 5/2019. En otros países existen leyes similares que protegen al consumidor.";
"kpi_commission_formula" = "Variable: 0,25% × importe (años 1-3)\nFija: 2% × importe (años 1-10)";
"kpi_commission_example" = "Amortizando 20.000€ en año 2 de hipoteca variable → comisión = 20.000 × 0,25% = 50€.";

"kpi_new_payment_title" = "Nueva cuota";
"kpi_new_payment_explanation" = "Si eliges reducir cuota con la amortización parcial, esta será tu nueva cuota mensual para el resto del préstamo, manteniendo el plazo original.";
"kpi_new_payment_formula" = "";
"kpi_new_payment_example" = "Cuota actual 898€/mes → tras amortizar 20.000€ → nueva cuota 798€/mes.";

"kpi_euribor_diff_monthly_title" = "Diferencia mensual";
"kpi_euribor_diff_monthly_explanation" = "Cuánto cambia tu cuota mensual si el Euríbor sube o baja según el escenario simulado. Un valor positivo significa que pagarás más.";
"kpi_euribor_diff_monthly_formula" = "";
"kpi_euribor_diff_monthly_example" = "Si el Euríbor sube 1 punto, una hipoteca de 150.000€ a 20 años puede subir ~60€/mes.";

"kpi_amortize_saving_title" = "Ahorro amortizando";
"kpi_amortize_saving_explanation" = "El beneficio garantizado de usar ese dinero para amortizar hipoteca. Es equivalente a obtener una rentabilidad igual al tipo de interés de tu hipoteca, sin riesgo.";
"kpi_amortize_saving_formula" = "Capital × ((1 + TIN)^años − 1)";
"kpi_amortize_saving_example" = "20.000€ en hipoteca al 3,5% durante 10 años → ahorro garantizado de 9.773€.";

"kpi_invest_gain_title" = "Ganancia invirtiendo";
"kpi_invest_gain_explanation" = "El beneficio esperado de invertir ese dinero en lugar de amortizar, aplicando la rentabilidad anual que introduces. Recuerda que la inversión conlleva riesgo y los rendimientos no están garantizados.";
"kpi_invest_gain_formula" = "Capital × ((1 + rentabilidad)^años − 1)";
"kpi_invest_gain_example" = "20.000€ al 7% anual durante 10 años → ganancia esperada de 19.343€.";

