// MARK: - Input field KPIs
"kpi_input_capital_title" = "Loan capital";
"kpi_input_capital_explanation" = "The total amount you borrow from the bank. This is the base on which interest is calculated. The lower the capital, the less total interest you will pay.";
"kpi_input_capital_example" = "Buying a home for €250,000 with a 20% down payment means a loan capital of €200,000.";

"kpi_input_years_title" = "Loan term";
"kpi_input_years_explanation" = "The number of years over which you repay the mortgage. Longer term = lower monthly payment, but much more total interest. Shorter term = higher payment but you save on interest.";
"kpi_input_years_example" = "A 25-year mortgage has lower payments than a 15-year one, but can cost twice as much in total interest.";

"kpi_input_rate_title" = "Interest rate (APR)";
"kpi_input_rate_explanation" = "The annual percentage the bank charges for lending you money. It is the most important factor determining mortgage cost. Small differences in tenths have a huge long-term impact.";
"kpi_input_rate_example" = "On €200,000 over 25 years, going from 3% to 4% means paying ~€28,000 more in total interest.";

"kpi_input_euribor_title" = "Euribor";
"kpi_input_euribor_explanation" = "The European interbank reference rate. Variable mortgages are calculated as Euribor + spread. It is reviewed annually and can rise or fall.";
"kpi_input_euribor_example" = "If Euribor is 3.75% and your spread is +0.75%, your effective rate will be 4.50%.";

"kpi_input_spread_title" = "Spread";
"kpi_input_spread_explanation" = "The margin added by the bank to Euribor to calculate your variable interest rate. It is fixed for the life of the loan and varies by bank and credit profile.";
"kpi_input_spread_example" = "A spread of 0.75% over Euribor 3.75% = effective rate 4.50%.";

"kpi_input_remaining_capital_title" = "Outstanding balance";
"kpi_input_remaining_capital_explanation" = "The debt you still owe the bank. This is the capital on which future monthly interest is calculated. You can find it on your last bank statement.";
"kpi_input_remaining_capital_example" = "If you borrowed €200,000 five years ago on a 25-year term, your outstanding balance is around €175,000.";

"kpi_input_months_title" = "Remaining months";
"kpi_input_months_explanation" = "The number of monthly instalments left to pay. Equivalent to the remaining term of your mortgage. 300 months = 25 years, 240 months = 20 years.";
"kpi_input_months_example" = "If you signed a 30-year mortgage 5 years ago, you have 300 months (25 years) remaining.";

"kpi_input_amortize_amount_title" = "Amount to prepay";
"kpi_input_amortize_amount_explanation" = "The lump sum you want to pay the bank to reduce your debt early. It could be savings, an inheritance, a bonus, etc.";
"kpi_input_amortize_amount_example" = "An extra €20,000 can eliminate several years from your mortgage or significantly reduce your monthly payment.";

"kpi_input_extra_monthly_title" = "Extra monthly payment";
"kpi_input_extra_monthly_explanation" = "An additional amount you pay each month on top of your regular instalment. All of this extra goes directly to reducing capital, shortening the term and saving a lot of interest.";
"kpi_input_extra_monthly_example" = "Paying €200 extra per month on a €150,000 mortgage at 3.5% over 25 years could finish it 5–7 years early.";

"kpi_input_stress_rate_title" = "Base rate for stress test";
"kpi_input_stress_rate_explanation" = "The starting interest rate for the stress test. The tool calculates what would happen to your payment if the rate rises or falls several percentage points from this base.";
"kpi_input_stress_rate_example" = "With a base rate of 3.5%, the test calculates your payment for scenarios ranging from 1.5% to 8.5%.";

