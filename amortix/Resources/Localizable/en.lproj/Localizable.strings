// MARK: - KPI info
"kpi_monthly_payment_title" = "Monthly payment";
"kpi_monthly_payment_explanation" = "The fixed amount you pay each month over the life of the loan. It includes a principal portion (what you repay of the loan) and an interest portion (the cost of borrowing money).";
"kpi_monthly_payment_formula" = "P × [r(1+r)^n] / [(1+r)^n - 1]\nP=principal  r=monthly rate  n=months";
"kpi_monthly_payment_example" = "Loan of $200,000 over 30 years at 3.5% → monthly payment of $898.";

"kpi_total_interest_title" = "Total interest";
"kpi_total_interest_explanation" = "The sum of all interest you will pay over the life of the loan. The higher the rate or the longer the term, the more interest you'll pay.";
"kpi_total_interest_formula" = "";
"kpi_total_interest_example" = "On a $200,000 loan over 30 years at 3.5%, you'll pay about $123,000 in interest alone.";

"kpi_total_cost_title" = "Total cost";
"kpi_total_cost_explanation" = "The total money you will repay to the bank: principal borrowed + all interest. It's the best metric for comparing two mortgages.";
"kpi_total_cost_formula" = "";
"kpi_total_cost_example" = "Principal $200,000 + $123,000 interest = $323,000 total cost.";

"kpi_months_saved_title" = "Months saved";
"kpi_months_saved_explanation" = "If you choose to reduce the term with a partial prepayment, these are the months you'll stop paying. The earlier in the loan, the greater the saving.";
"kpi_months_saved_formula" = "n_new = -ln(1 - P_new × r / payment) / ln(1 + r)";
"kpi_months_saved_example" = "Prepaying $20,000 in year 5 of a 30-year mortgage could eliminate 4–6 years of payments.";

"kpi_interest_saved_title" = "Interest saved";
"kpi_interest_saved_explanation" = "The difference between the interest you'd pay without prepaying and the interest you'll pay after prepaying. This is the gross saving before deducting any prepayment fee.";
"kpi_interest_saved_formula" = "";
"kpi_interest_saved_example" = "Prepaying $20,000 can save between $8,000 and $18,000 in interest depending on timing.";

"kpi_net_saving_title" = "Net saving";
"kpi_net_saving_explanation" = "The real saving: interest saved minus the early repayment fee charged by the lender. If negative, prepaying doesn't make sense.";
"kpi_net_saving_formula" = "Net saving = Interest saved − Fee";
"kpi_net_saving_example" = "Interest saved $15,000 − Fee $500 = Net saving $14,500.";

"kpi_commission_title" = "Prepayment fee";
"kpi_commission_explanation" = "The lender may charge a fee for early repayment. Regulations vary by country and protect the consumer.";
"kpi_commission_formula" = "Variable: 0.25% × amount (years 1–3)\nFixed: 2% × amount (years 1–10)";
"kpi_commission_example" = "Prepaying $20,000 in year 2 of a variable mortgage → fee = $20,000 × 0.25% = $50.";

"kpi_new_payment_title" = "New payment";
"kpi_new_payment_explanation" = "If you choose to reduce your payment with a partial prepayment, this will be your new monthly payment for the rest of the loan, keeping the original term.";
"kpi_new_payment_formula" = "";
"kpi_new_payment_example" = "Current payment $898/mo → after prepaying $20,000 → new payment $798/mo.";

"kpi_euribor_diff_monthly_title" = "Monthly difference";
"kpi_euribor_diff_monthly_explanation" = "How much your monthly payment changes if rates rise or fall according to the simulated scenario. A positive value means you'll pay more.";
"kpi_euribor_diff_monthly_formula" = "";
"kpi_euribor_diff_monthly_example" = "If rates rise 1 point, a $150,000 mortgage over 20 years may increase ~$60/month.";

"kpi_amortize_saving_title" = "Savings from paying down";
"kpi_amortize_saving_explanation" = "The guaranteed benefit of using that money to pay down your mortgage. It's equivalent to earning a return equal to your mortgage rate, risk-free.";
"kpi_amortize_saving_formula" = "Principal × ((1 + rate)^years − 1)";
"kpi_amortize_saving_example" = "$20,000 at 3.5% mortgage rate for 10 years → guaranteed saving of $9,773.";

"kpi_invest_gain_title" = "Gain from investing";
"kpi_invest_gain_explanation" = "The expected benefit of investing that money instead of paying down your mortgage, applying the annual return you enter. Remember that investing involves risk and returns are not guaranteed.";
"kpi_invest_gain_formula" = "Principal × ((1 + return)^years − 1)";
"kpi_invest_gain_example" = "$20,000 at 7% annual return for 10 years → expected gain of $19,343.";

