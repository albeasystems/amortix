// MARK: - KPI info
"kpi_monthly_payment_title" = "Rata mensile";
"kpi_monthly_payment_explanation" = "L'importo fisso che paghi ogni mese per tutta la durata del finanziamento. Include una quota capitale (ciò che restituisci del prestito) e una quota interessi (il costo del denaro preso in prestito).";
"kpi_monthly_payment_formula" = "C × [r(1+r)^n] / [(1+r)^n - 1]\nC=capitale  r=tasso mensile  n=mesi";
"kpi_monthly_payment_example" = "Mutuo 200.000€ a 30 anni al 3,5% → rata mensile di 898€.";

"kpi_total_interest_title" = "Totale interessi";
"kpi_total_interest_explanation" = "La somma di tutti gli interessi che pagherai nel corso della durata del finanziamento. Maggiore è il tasso o la durata, più interessi pagherai.";
"kpi_total_interest_formula" = "";
"kpi_total_interest_example" = "Su un mutuo di 200.000€ a 30 anni al 3,5%, pagherai circa 123.000€ solo di interessi.";

"kpi_total_cost_title" = "Costo totale";
"kpi_total_cost_explanation" = "Il denaro totale che restituirai alla banca: capitale prestato + tutti gli interessi. È la migliore metrica per confrontare due mutui.";
"kpi_total_cost_formula" = "";
"kpi_total_cost_example" = "Capitale 200.000€ + 123.000€ interessi = 323.000€ costo totale.";

"kpi_months_saved_title" = "Mesi risparmiati";
"kpi_months_saved_explanation" = "Se scegli di ridurre la durata con un rimborso parziale, questi sono i mesi che non pagherai più. Prima avviene nel finanziamento, maggiore sarà il risparmio.";
"kpi_months_saved_formula" = "n_nuovo = -ln(1 - C_nuovo × r / rata) / ln(1 + r)";
"kpi_months_saved_example" = "Rimborsando 20.000€ all'anno 5 di un mutuo a 30 anni potresti eliminare 4-6 anni di pagamenti.";

"kpi_interest_saved_title" = "Interessi risparmiati";
"kpi_interest_saved_explanation" = "La differenza tra gli interessi che pagheresti senza rimborso anticipato e quelli che pagherai dopo. È il risparmio lordo prima di detrarre la penale.";
"kpi_interest_saved_formula" = "";
"kpi_interest_saved_example" = "Rimborsando 20.000€ puoi risparmiare tra 8.000€ e 18.000€ di interessi a seconda del momento.";

"kpi_net_saving_title" = "Risparmio netto";
"kpi_net_saving_explanation" = "Il risparmio reale: interessi risparmiati meno la penale di estinzione anticipata addebitata dalla banca. Se negativo, il rimborso anticipato non conviene.";
"kpi_net_saving_formula" = "Risparmio netto = Interessi risparmiati − Penale";
"kpi_net_saving_example" = "Interessi risparmiati 15.000€ − Penale 500€ = Risparmio netto 14.500€.";

"kpi_commission_title" = "Penale di estinzione";
"kpi_commission_explanation" = "La banca può addebitare una penale per l'estinzione anticipata. La normativa varia per paese e tutela il consumatore.";
"kpi_commission_formula" = "Variabile: 0,25% × importo (anni 1-3)\nFisso: 2% × importo (anni 1-10)";
"kpi_commission_example" = "Rimborsando 20.000€ all'anno 2 di un mutuo variabile → penale = 20.000 × 0,25% = 50€.";

"kpi_new_payment_title" = "Nuova rata";
"kpi_new_payment_explanation" = "Se scegli di ridurre la rata con il rimborso parziale, questa sarà la tua nuova rata mensile per il resto del finanziamento, mantenendo la durata originale.";
"kpi_new_payment_formula" = "";
"kpi_new_payment_example" = "Rata attuale 898€/mese → dopo rimborso di 20.000€ → nuova rata 798€/mese.";

"kpi_euribor_diff_monthly_title" = "Differenza mensile";
"kpi_euribor_diff_monthly_explanation" = "Di quanto cambia la tua rata mensile se i tassi salgono o scendono secondo lo scenario simulato. Un valore positivo significa che pagherai di più.";
"kpi_euribor_diff_monthly_formula" = "";
"kpi_euribor_diff_monthly_example" = "Se i tassi salgono di 1 punto, un mutuo di 150.000€ a 20 anni può aumentare di ~60€/mese.";

"kpi_amortize_saving_title" = "Risparmio estinguendo";
"kpi_amortize_saving_explanation" = "Il beneficio garantito di usare quel denaro per estinguere il mutuo. È equivalente a ottenere un rendimento pari al tasso del tuo mutuo, senza rischio.";
"kpi_amortize_saving_formula" = "Capitale × ((1 + tasso)^anni − 1)";
"kpi_amortize_saving_example" = "20.000€ su mutuo al 3,5% per 10 anni → risparmio garantito di 9.773€.";

"kpi_invest_gain_title" = "Guadagno investendo";
"kpi_invest_gain_explanation" = "Il beneficio atteso di investire quel denaro invece di estinguere il mutuo, applicando il rendimento annuo che inserisci. Ricorda che l'investimento comporta rischi e i rendimenti non sono garantiti.";
"kpi_invest_gain_formula" = "Capitale × ((1 + rendimento)^anni − 1)";
"kpi_invest_gain_example" = "20.000€ al 7% annuo per 10 anni → guadagno atteso di 19.343€.";

