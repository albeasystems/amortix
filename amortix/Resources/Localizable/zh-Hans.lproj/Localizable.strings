// MARK: - KPI info
"kpi_monthly_payment_title" = "月供";
"kpi_monthly_payment_explanation" = "贷款存续期间每月支付的固定金额。包含本金部分（偿还贷款本金）和利息部分（借款成本）。";
"kpi_monthly_payment_formula" = "P × [r(1+r)^n] / [(1+r)^n - 1]\nP=本金  r=月利率  n=期数（月）";
"kpi_monthly_payment_example" = "20万元贷款，30年，年利率3.5% → 月供898元。";

"kpi_total_interest_title" = "总利息";
"kpi_total_interest_explanation" = "贷款存续期间支付的所有利息之和。利率越高或期限越长，支付的利息越多。";
"kpi_total_interest_formula" = "";
"kpi_total_interest_example" = "20万元贷款，30年，年利率3.5%，仅利息就需支付约12.3万元。";

"kpi_total_cost_title" = "总费用";
"kpi_total_cost_explanation" = "还给银行的全部资金：贷款本金 + 所有利息。是比较两笔贷款的最佳指标。";
"kpi_total_cost_formula" = "";
"kpi_total_cost_example" = "本金20万 + 利息12.3万 = 总费用32.3万。";

"kpi_months_saved_title" = "节省月数";
"kpi_months_saved_explanation" = "选择部分提前还款并缩短期限时，这是您将少还的月数。越早进行提前还款，节省越多。";
"kpi_months_saved_formula" = "n_新 = -ln(1 - P_新 × r / 月供) / ln(1 + r)";
"kpi_months_saved_example" = "30年贷款第5年提前还款2万元，可节省4-6年还款期。";

"kpi_interest_saved_title" = "节省利息";
"kpi_interest_saved_explanation" = "不提前还款的利息与提前还款后利息之差。这是扣除违约金前的毛节省额。";
"kpi_interest_saved_formula" = "";
"kpi_interest_saved_example" = "提前还款2万元，根据时间节点可节省8,000至18,000元利息。";

"kpi_net_saving_title" = "净节省金额";
"kpi_net_saving_explanation" = "实际节省金额：节省利息减去银行收取的提前还款违约金。若为负数，则提前还款不划算。";
"kpi_net_saving_formula" = "净节省 = 节省利息 − 违约金";
"kpi_net_saving_example" = "节省利息1.5万 − 违约金500 = 净节省1.45万。";

"kpi_commission_title" = "提前还款违约金";
"kpi_commission_explanation" = "银行可能对提前还款收取违约金。各国法规不同，均对消费者有一定保护。";
"kpi_commission_formula" = "浮动利率：0.25% × 金额（第1-3年）\n固定利率：2% × 金额（第1-10年）";
"kpi_commission_example" = "浮动利率贷款第2年提前还款2万 → 违约金 = 20,000 × 0.25% = 50元。";

"kpi_new_payment_title" = "新月供";
"kpi_new_payment_explanation" = "选择部分提前还款后减少月供，这将是您在保持原还款期限的情况下，剩余贷款期间的新月供金额。";
"kpi_new_payment_formula" = "";
"kpi_new_payment_example" = "当前月供898元 → 提前还款2万后 → 新月供798元。";

"kpi_euribor_diff_monthly_title" = "每月差额";
"kpi_euribor_diff_monthly_explanation" = "按模拟情景利率上升或下降后，月供的变化幅度。正值表示需多付费用。";
"kpi_euribor_diff_monthly_formula" = "";
"kpi_euribor_diff_monthly_example" = "利率上升1个百分点，15万元20年期贷款月供约增加60元。";

"kpi_amortize_saving_title" = "提前还款节省";
"kpi_amortize_saving_explanation" = "将这笔钱用于提前还款的确定性收益。相当于以与贷款利率相同的无风险收益率获得回报。";
"kpi_amortize_saving_formula" = "本金 × ((1 + 利率)^年数 − 1)";
"kpi_amortize_saving_example" = "2万元，贷款利率3.5%，期限10年 → 确定节省9,773元。";

"kpi_invest_gain_title" = "投资收益";
"kpi_invest_gain_explanation" = "将这笔钱用于投资而非提前还款的预期收益，按您输入的年收益率计算。请记住，投资存在风险，收益不受保证。";
"kpi_invest_gain_formula" = "本金 × ((1 + 收益率)^年数 − 1)";
"kpi_invest_gain_example" = "2万元，年收益率7%，期限10年 → 预期收益19,343元。";

