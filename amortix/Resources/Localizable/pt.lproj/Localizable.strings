// MARK: - KPI info
"kpi_monthly_payment_title" = "Parcela mensal";
"kpi_monthly_payment_explanation" = "O valor fixo que você paga todo mês durante toda a vigência do empréstimo. Inclui uma parte do capital (o que você está devolvendo do empréstimo) e uma parte de juros (o custo do dinheiro emprestado).";
"kpi_monthly_payment_formula" = "C × [r(1+r)^n] / [(1+r)^n - 1]\nC=capital  r=taxa mensal  n=meses";
"kpi_monthly_payment_example" = "Financiamento de R$200.000 em 30 anos a 3,5% → parcela mensal de R$898.";

"kpi_total_interest_title" = "Total de juros";
"kpi_total_interest_explanation" = "A soma de todos os juros que você pagará ao longo da vida do empréstimo. Quanto maior a taxa ou o prazo, mais juros você pagará.";
"kpi_total_interest_formula" = "";
"kpi_total_interest_example" = "Em um financiamento de R$200.000 em 30 anos a 3,5%, você pagará cerca de R$123.000 só em juros.";

"kpi_total_cost_title" = "Custo total";
"kpi_total_cost_explanation" = "O dinheiro total que você devolverá ao banco: capital emprestado + todos os juros. É a melhor métrica para comparar dois financiamentos.";
"kpi_total_cost_formula" = "";
"kpi_total_cost_example" = "Capital R$200.000 + R$123.000 em juros = R$323.000 custo total.";

"kpi_months_saved_title" = "Meses economizados";
"kpi_months_saved_explanation" = "Se você optar por reduzir o prazo com uma amortização parcial, esses são os meses que você deixará de pagar. Quanto mais cedo no financiamento, maior será a economia.";
"kpi_months_saved_formula" = "n_novo = -ln(1 - C_novo × r / parcela) / ln(1 + r)";
"kpi_months_saved_example" = "Amortizando R$20.000 no ano 5 de um financiamento de 30 anos, você poderia eliminar 4 a 6 anos de pagamentos.";

"kpi_interest_saved_title" = "Juros economizados";
"kpi_interest_saved_explanation" = "A diferença entre os juros que você pagaria sem amortizar e os que pagará após a amortização. É a economia bruta antes de deduzir a multa.";
"kpi_interest_saved_formula" = "";
"kpi_interest_saved_example" = "Amortizando R$20.000 você pode economizar entre R$8.000 e R$18.000 em juros dependendo do momento.";

"kpi_net_saving_title" = "Economia líquida";
"kpi_net_saving_explanation" = "A economia real: juros economizados menos a multa por liquidação antecipada cobrada pelo banco. Se for negativa, não vale a pena amortizar.";
"kpi_net_saving_formula" = "Economia líquida = Juros economizados − Multa";
"kpi_net_saving_example" = "Juros economizados R$15.000 − Multa R$500 = Economia líquida R$14.500.";

"kpi_commission_title" = "Multa por liquidação";
"kpi_commission_explanation" = "O banco pode cobrar uma multa pela liquidação antecipada. A regulamentação varia por país e protege o consumidor.";
"kpi_commission_formula" = "Variável: 0,25% × valor (anos 1-3)\nFixo: 2% × valor (anos 1-10)";
"kpi_commission_example" = "Amortizando R$20.000 no ano 2 de financiamento variável → multa = R$20.000 × 0,25% = R$50.";

"kpi_new_payment_title" = "Nova parcela";
"kpi_new_payment_explanation" = "Se você optar por reduzir a parcela com a amortização parcial, esta será sua nova parcela mensal pelo restante do financiamento, mantendo o prazo original.";
"kpi_new_payment_formula" = "";
"kpi_new_payment_example" = "Parcela atual R$898/mês → após amortizar R$20.000 → nova parcela R$798/mês.";

"kpi_euribor_diff_monthly_title" = "Diferença mensal";
"kpi_euribor_diff_monthly_explanation" = "O quanto sua parcela mensal muda se os juros sobem ou descem conforme o cenário simulado. Um valor positivo significa que você pagará mais.";
"kpi_euribor_diff_monthly_formula" = "";
"kpi_euribor_diff_monthly_example" = "Se os juros subirem 1 ponto, um financiamento de R$150.000 em 20 anos pode aumentar ~R$60/mês.";

"kpi_amortize_saving_title" = "Economia amortizando";
"kpi_amortize_saving_explanation" = "O benefício garantido de usar esse dinheiro para amortizar o financiamento. É equivalente a obter um retorno igual à taxa do seu financiamento, sem risco.";
"kpi_amortize_saving_formula" = "Capital × ((1 + taxa)^anos − 1)";
"kpi_amortize_saving_example" = "R$20.000 em financiamento a 3,5% por 10 anos → economia garantida de R$9.773.";

"kpi_invest_gain_title" = "Ganho investindo";
"kpi_invest_gain_explanation" = "O benefício esperado de investir esse dinheiro em vez de amortizar, aplicando a rentabilidade anual que você insere. Lembre-se de que investimentos envolvem riscos e os rendimentos não são garantidos.";
"kpi_invest_gain_formula" = "Capital × ((1 + rentabilidade)^anos − 1)";
