// MARK: - KPI info
"kpi_monthly_payment_title" = "القسط الشهري";
"kpi_monthly_payment_explanation" = "المبلغ الثابت الذي تدفعه كل شهر طوال فترة التمويل. يشمل جزءاً من رأس المال (ما تسدده من القرض) وجزءاً من الفوائد (تكلفة المال المقترض).";
"kpi_monthly_payment_formula" = "C × [r(1+r)^n] / [(1+r)^n - 1]\nC=رأس المال  r=الفائدة الشهرية  n=الأشهر";
"kpi_monthly_payment_example" = "تمويل 200,000 وحدة على 30 سنة بنسبة 3.5% → قسط شهري 898 وحدة.";

"kpi_total_interest_title" = "إجمالي الفوائد";
"kpi_total_interest_explanation" = "مجموع جميع الفوائد التي ستدفعها على مدى فترة التمويل. كلما زادت نسبة الفائدة أو المدة، زادت الفوائد.";
"kpi_total_interest_formula" = "";
"kpi_total_interest_example" = "في تمويل بـ 200,000 وحدة على 30 سنة بنسبة 3.5%، ستدفع نحو 123,000 وحدة فوائد.";

"kpi_total_cost_title" = "التكلفة الإجمالية";
"kpi_total_cost_explanation" = "إجمالي الأموال التي ستردها للبنك: رأس المال + جميع الفوائد. هي أفضل مقياس لمقارنة عرضين تمويليين.";
"kpi_total_cost_formula" = "";
"kpi_total_cost_example" = "رأس المال 200,000 + 123,000 فوائد = 323,000 تكلفة إجمالية.";

"kpi_months_saved_title" = "الأشهر المُوفَّرة";
"kpi_months_saved_explanation" = "إذا اخترت تقليص المدة بسداد جزئي مبكر، فهذه هي الأشهر التي لن تدفعها. كلما كان السداد في بداية التمويل، كان التوفير أكبر.";
"kpi_months_saved_formula" = "n_جديد = -ln(1 - C_جديد × r / قسط) / ln(1 + r)";
"kpi_months_saved_example" = "سداد مبكر بـ 20,000 وحدة في السنة 5 من تمويل 30 سنة قد يُزيل 4-6 سنوات من الأقساط.";

"kpi_interest_saved_title" = "الفوائد المُوفَّرة";
"kpi_interest_saved_explanation" = "الفرق بين الفوائد التي كنت ستدفعها بدون سداد مبكر وتلك التي ستدفعها بعده. هذا هو التوفير الإجمالي قبل خصم رسوم السداد المبكر.";
"kpi_interest_saved_formula" = "";
"kpi_interest_saved_example" = "سداد مبكر بـ 20,000 وحدة قد يُوفّر بين 8,000 و18,000 وحدة من الفوائد حسب التوقيت.";

"kpi_net_saving_title" = "التوفير الصافي";
"kpi_net_saving_explanation" = "التوفير الحقيقي: الفوائد المُوفَّرة مطروحاً منها رسوم السداد المبكر التي يفرضها البنك. إذا كانت سالبة، فالسداد المبكر غير مجدٍ.";
"kpi_net_saving_formula" = "التوفير الصافي = الفوائد المُوفَّرة − الرسوم";
"kpi_net_saving_example" = "فوائد موفرة 15,000 − رسوم 500 = توفير صافٍ 14,500.";

"kpi_commission_title" = "رسوم السداد المبكر";
"kpi_commission_explanation" = "قد يفرض البنك رسوماً على السداد المبكر. تتباين اللوائح حسب الدولة وتحمي المستهلك.";
"kpi_commission_formula" = "متغير: 0.25% × المبلغ (السنوات 1-3)\nثابت: 2% × المبلغ (السنوات 1-10)";
"kpi_commission_example" = "سداد مبكر بـ 20,000 في السنة 2 من تمويل متغير → رسوم = 20,000 × 0.25% = 50.";

"kpi_new_payment_title" = "القسط الجديد";
"kpi_new_payment_explanation" = "إذا اخترت تخفيض القسط بالسداد الجزئي المبكر، فهذا سيكون قسطك الشهري الجديد لبقية التمويل مع الإبقاء على المدة الأصلية.";
